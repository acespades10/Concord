FROM node:24-bookworm-slim AS web-builder
WORKDIR /repo
RUN corepack enable
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/web/package.json apps/web/package.json
RUN pnpm install --frozen-lockfile
COPY apps/web apps/web
ENV API_URL=http://127.0.0.1:8000 NEXT_TELEMETRY_DISABLED=1
RUN pnpm --filter @concord/web build

FROM ghcr.io/astral-sh/uv:0.11.29 AS uv
FROM python:3.12-slim-bookworm AS api-builder
COPY --from=uv /uv /bin/
WORKDIR /app/api
COPY apps/api/pyproject.toml apps/api/uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project

FROM python:3.12-slim-bookworm AS runtime
RUN apt-get update && apt-get install -y --no-install-recommends libstdc++6 ca-certificates && rm -rf /var/lib/apt/lists/* && useradd --create-home --uid 10001 concord
COPY --from=web-builder /usr/local/bin/node /usr/local/bin/node
WORKDIR /app/api
COPY --from=api-builder /app/api/.venv /app/api/.venv
COPY --chown=concord:concord apps/api/ ./
COPY --from=web-builder --chown=concord:concord /repo/apps/web/.next/standalone /app/web/
COPY --from=web-builder --chown=concord:concord /repo/apps/web/.next/static /app/web/apps/web/.next/static
ENV PATH="/app/api/.venv/bin:$PATH" PYTHONUNBUFFERED=1 APP_ENV=production COOKIE_SECURE=true NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 NODE_OPTIONS=--max-old-space-size=160 PORT=10000
USER concord
EXPOSE 10000
CMD ["python", "-m", "app.hosted"]
